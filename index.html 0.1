```html
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>अफ़र सिंह | My Profile</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

:root{
    --bg:#f3f5f9;
    --card:#ffffff;
    --text:#171717;
    --sub:#666;
    --main:#635bff;
}

body{
    background:var(--bg);
    color:var(--text);
    transition:.3s;
}

body.dark{
    --bg:#0d0f14;
    --card:#181b22;
    --text:#fff;
    --sub:#aaa;
}

/* HEADER */

header{
    background:var(--card);
    padding:18px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:sticky;
    top:0;
    z-index:100;
    box-shadow:0 2px 15px #0001;
}

.logo{
    font-size:25px;
    font-weight:bold;
    color:var(--main);
}

button{
    border:0;
    cursor:pointer;
}

.mode{
    padding:10px 17px;
    border-radius:25px;
    background:var(--main);
    color:white;
}

/* HERO */

.hero{
    min-height:75vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:50px 20px;
}

.profile{
    max-width:750px;
}

.main-photo{
    width:260px;
    height:260px;
    border-radius:50%;
    object-fit:cover;
    border:7px solid var(--main);
    margin-bottom:25px;
    box-shadow:0 15px 40px #0003;
}

h1{
    font-size:48px;
    margin-bottom:15px;
}

h1 span{
    color:var(--main);
}

.bio{
    color:var(--sub);
    font-size:18px;
    line-height:1.7;
    margin:15px auto 25px;
}

.contact{
    display:inline-block;
    padding:14px 26px;
    background:var(--main);
    color:white;
    text-decoration:none;
    border-radius:30px;
    font-weight:bold;
}

/* GALLERY */

.gallery-section{
    padding:70px 7%;
}

.gallery-title{
    text-align:center;
    margin-bottom:35px;
}

.gallery-title h2{
    font-size:38px;
    margin-bottom:10px;
}

.gallery-title p{
    color:var(--sub);
}

.gallery{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.gallery-card{
    background:var(--card);
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 8px 25px #0002;
    transition:.3s;
}

.gallery-card:hover{
    transform:translateY(-7px);
}

.gallery-card img{
    width:100%;
    height:260px;
    object-fit:cover;
    display:block;
}

/* ADMIN */

.admin{
    max-width:650px;
    margin:30px auto 70px;
    padding:30px;
    background:var(--card);
    border-radius:20px;
    box-shadow:0 10px 30px #0001;
    text-align:center;
}

.admin h2{
    margin-bottom:10px;
}

.admin p{
    color:var(--sub);
    margin-bottom:20px;
}

input[type=password]{
    width:100%;
    padding:14px;
    border:1px solid #aaa;
    border-radius:10px;
    margin-bottom:12px;
}

.upload-box{
    display:none;
    margin-top:25px;
}

.upload-label{
    display:inline-block;
    padding:14px 25px;
    background:var(--main);
    color:white;
    border-radius:30px;
    cursor:pointer;
    font-weight:bold;
}

input[type=file]{
    display:none;
}

.delete-btn{
    margin-top:20px;
    padding:11px 20px;
    background:#e53935;
    color:white;
    border-radius:20px;
}

/* FOOTER */

footer{
    text-align:center;
    padding:25px;
    background:var(--card);
    color:var(--sub);
}

/* MOBILE */

@media(max-width:600px){

    h1{
        font-size:36px;
    }

    .main-photo{
        width:210px;
        height:210px;
    }

    .gallery{
        grid-template-columns:repeat(2,1fr);
        gap:12px;
    }

    .gallery-card img{
        height:190px;
    }
}
</style>
</head>


<body>

<!-- HEADER -->

<header>

    <div class="logo">
        अफ़र सिंह
    </div>

    <button
        class="mode"
        id="modeBtn"
        onclick="toggleMode()">
        🌙 Dark Mode
    </button>

</header>


<!-- PROFILE -->

<section class="hero">

    <div class="profile">

        <img
            id="mainPhoto"
            class="main-photo"
            src="https://via.placeholder.com/500"
            alt="अफ़र सिंह">

        <h1>
            नमस्ते, मैं <span>अफ़र सिंह</span> हूँ
        </h1>

        <p class="bio">
            Welcome to my personal website.
            यहाँ आप मेरी profile और मेरी सभी photos देख सकते हैं।
        </p>

        <a
            class="contact"
            href="tel:8299842211">
            📞 8299842211
        </a>

    </div>

</section>


<!-- PHOTO GALLERY -->

<section class="gallery-section">

    <div class="gallery-title">

        <h2>📸 मेरी फोटो गैलरी</h2>

        <p>
            मेरी सभी photos यहाँ दिखाई देंगी।
        </p>

    </div>


    <div
        class="gallery"
        id="gallery">

        <!-- Photos JavaScript से यहाँ आएंगी -->

    </div>

</section>


<!-- OWNER PANEL -->

<section class="admin">

    <h2>🔐 Owner Photo Panel</h2>

    <p>
        केवल owner password डालकर अपनी कई सारी photos upload करें।
    </p>

    <input
        type="password"
        id="password"
        placeholder="Owner Password">

    <br>

    <button
        class="mode"
        onclick="login()">
        Login
    </button>


    <div
        class="upload-box"
        id="uploadBox">

        <p>
            एक साथ कई photos चुन सकते हैं:
        </p>

        <label
            class="upload-label"
            for="photoInput">

            📸 कई फोटो Upload करें

        </label>

        <input
            type="file"
            id="photoInput"
            accept="image/*"
            multiple>

        <br>

        <button
            class="delete-btn"
            onclick="deleteAllPhotos()">

            🗑️ सभी Photos Delete करें

        </button>

    </div>

</section>


<footer>

    © 2026 अफ़र सिंह | My Personal Website

</footer>


<script>

/* =========================
   PASSWORD
========================= */

const OWNER_PASSWORD = "Abhay@123";


function login(){

    const password =
        document.getElementById("password").value;

    if(password === OWNER_PASSWORD){

        document.getElementById("uploadBox").style.display =
            "block";

        alert("Owner Login Successful!");

    }else{

        alert("गलत Password!");

    }
}


/* =========================
   PHOTO SYSTEM
========================= */

const photoInput =
    document.getElementById("photoInput");

const gallery =
    document.getElementById("gallery");

const mainPhoto =
    document.getElementById("mainPhoto");


let photos =
    JSON.parse(localStorage.getItem("afarSinghPhotos")) || [];


/* पुरानी photos दिखाएँ */

function showPhotos(){

    gallery.innerHTML = "";

    if(photos.length === 0){

        gallery.innerHTML = `
            <p style="grid-column:1/-1;text-align:center;color:#777;">
                अभी कोई फोटो upload नहीं की गई है।
            </p>
        `;

        return;
    }


    /* पहली फोटो profile photo */

    mainPhoto.src = photos[0];


    photos.forEach(function(photo){

        const card =
            document.createElement("div");

        card.className =
            "gallery-card";


        const image =
            document.createElement("img");

        image.src = photo;

        image.alt =
            "अफ़र सिंह Photo";


        card.appendChild(image);

        gallery.appendChild(card);

    });

}


/* =========================
   MULTIPLE UPLOAD
========================= */

photoInput.addEventListener("change", function(){

    const files =
        Array.from(this.files);


    if(files.length === 0){
        return;
    }


    let completed = 0;


    files.forEach(function(file){

        if(!file.type.startsWith("image/")){
            return;
        }


        const reader =
            new FileReader();


        reader.onload = function(e){

            photos.push(e.target.result);

            completed++;


            if(completed === files.length){

                localStorage.setItem(
                    "afarSinghPhotos",
                    JSON.stringify(photos)
                );

                showPhotos();

                alert(
                    completed +
                    " photos successfully upload हो गईं!"
                );

            }

        };


        reader.readAsDataURL(file);

    });


    /* input reset */

    this.value = "";

});


/* =========================
   DELETE ALL
========================= */

function deleteAllPhotos(){

    if(photos.length === 0){
        alert("Delete करने के लिए कोई photo नहीं है।");
        return;
    }


    const confirmDelete =
        confirm(
            "क्या आप सभी photos delete करना चाहते हैं?"
        );


    if(confirmDelete){

        photos = [];

        localStorage.removeItem(
            "afarSinghPhotos"
        );

        showPhotos();

        mainPhoto.src =
            "https://via.placeholder.com/500";

        alert("सभी photos delete हो गईं।");

    }

}


/* =========================
   DARK MODE
========================= */

function toggleMode(){

    document.body.classList.toggle("dark");

    const btn =
        document.getElementById("modeBtn");


    if(document.body.classList.contains("dark")){

        btn.innerHTML = "☀️ Day Mode";

        localStorage.setItem(
            "theme",
            "dark"
        );

    }else{

        btn.innerHTML = "🌙 Dark Mode";

        localStorage.setItem(
            "theme",
            "light"
        );

    }

}


/* Saved Theme */

if(
    localStorage.getItem("theme") === "dark"
){

    document.body.classList.add("dark");

    document.getElementById("modeBtn").innerHTML =
        "☀️ Day Mode";

}


/* Start */

showPhotos();

</script>

</body>
</html>
```
